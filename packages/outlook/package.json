{
  "name": "@mailroll/outlook",
  "version": "0.1.0",
  "description": "The official Microsoft Outlook (Microsoft Graph) integration for mailroll: sends through a Microsoft 365 mailbox with delegated sign-in, plus the mailroll-outlook tool to export Sent Items.",
  "keywords": [
    "email",
    "mailroll",
    "outlook",
    "microsoft-graph",
    "microsoft-365",
    "integration"
  ],
  "homepage": "https://github.com/juans-castellanosr/mailroll/tree/main/packages/outlook#readme",
  "bugs": {
    "url": "https://github.com/juans-castellanosr/mailroll/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juans-castellanosr/mailroll.git",
    "directory": "packages/outlook"
  },
  "license": "MIT",
  "author": "Juan Sebastian Castellanos Rivillas",
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "mailroll-outlook": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "!dist/cli.d.mts"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "node scripts/verify-package.ts",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@mailroll/core": "workspace:^",
    "mailroll": "workspace:^"
  },
  "peerDependenciesMeta": {
    "mailroll": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mailroll/core": "workspace:^",
    "mailroll": "workspace:^"
  }
}
