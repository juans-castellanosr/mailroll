{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "pnpm -r run test:package",
    "test:integrations": "pnpm -r run test:integrations",
    "test:browser": "pnpm -r run test:browser",
    "check:package": "pnpm -r run check:package",
    "docs:dev": "cd docs && npx --yes mint@4.3.14 dev",
    "docs:check": "cd docs && npx --yes mint@4.3.14 validate && npx --yes mint@4.3.14 broken-links --check-anchors",
    "docs:a11y": "cd docs && npx --yes mint@4.3.14 a11y",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
